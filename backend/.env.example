# Backend-only configuration. Copy to backend/.env; never commit the real file.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@[SUPABASE_DB_HOST]:5432/postgres
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
STORAGE_BUCKET=bizpilot-assets

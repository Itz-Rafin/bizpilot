# Backend-only configuration. Copy to backend/.env; never commit the real file.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@[SUPABASE_DB_HOST]:5432/postgres
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
# Required only for legacy HS256 projects. Leave empty when using asymmetric signing keys.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
STORAGE_BUCKET=bizpilot-assets

# SMTP invoice delivery. Use your transactional email provider credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Process-local API protection. Put a shared rate limiter/API gateway in front of
# multi-instance deployments and keep these values as a second layer.
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

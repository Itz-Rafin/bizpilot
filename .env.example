# Reference template only.
# Canonical setup files are backend/.env and frontend/.env.local.
# Copy the matching example file and fill in your own project values.

# Frontend-public values (safe for browser configuration; do not put secrets here)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend-only values
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@[SUPABASE_DB_HOST]:5432/postgres
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
STORAGE_BUCKET=bizpilot-assets
